# CivicConnect Environment Configuration Template
# Kopargaon, Maharashtra Civic Issue Reporting Platform

# Server Configuration
PORT=3000
NODE_ENV=development

# Google Cloud Vision API Credentials
# Replace with your Google Cloud Project ID and path to service account key JSON
GOOGLE_CLOUD_PROJECT=civicconnect-kopargaon
GOOGLE_APPLICATION_CREDENTIALS=./keys/service-account.json

# Vision Confidence Thresholds & Rules
VISION_MIN_CONFIDENCE=0.80
VISION_REVIEW_CONFIDENCE=0.60
VISION_VALIDATION_EXPIRY_MINUTES=30

# Image Constraints
MAX_IMAGE_SIZE_MB=10
MIN_IMAGE_WIDTH=640
MIN_IMAGE_HEIGHT=480

# Provider Selection: 'google_cloud_vision' (production) or 'mock' (local testing)
VISION_PROVIDER=mock

# Timeout for Google Vision API calls in milliseconds
VISION_REQUEST_TIMEOUT_MS=10000

# Rate Limiting: Max validation requests per IP per minute
RATE_LIMIT_VALIDATIONS_PER_MIN=30

# ==============================================================================
# Supabase Cloud Configuration (PostgreSQL Database, Auth & Storage)
# ==============================================================================
# Found in your Supabase Dashboard: Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Supabase Storage bucket for citizen complaint photos
SUPABASE_STORAGE_BUCKET=complaint-images

